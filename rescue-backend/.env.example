# HTTP server
PORT=3000

# MySQL (matches the local Docker Compose defaults)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rescue_demo
DB_USER=rescue_user
DB_PASSWORD=REPLACE_WITH_A_STRONG_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_A_DIFFERENT_STRONG_ROOT_PASSWORD

# Set DB_SSL=true only when the database provider requires TLS.
DB_SSL=false
# DB_SSL_CA=REPLACE_WITH_THE_PROVIDER_CA_CERTIFICATE

# Redis
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# Use a long random value. The backend refuses to start without it.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# LINE Login channel ID used to verify LIFF ID tokens.
LINE_LOGIN_CHANNEL_ID=REPLACE_WITH_YOUR_LINE_LOGIN_CHANNEL_ID

# Long-lived channel access token from the recipient's Messaging API channel.
# Leave blank when LINE push and broadcast are unused.
LINE_CHANNEL_ACCESS_TOKEN=
